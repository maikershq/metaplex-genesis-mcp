{
  "name": "metaplex-genesis-mcp",
  "version": "1.1.0",
  "description": "MCP server for interacting with Metaplex Genesis program on Solana",
  "license": "Apache-2.0",
  "type": "module",
  "author": "maikers <dev@maikers.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maikershq/metaplex-genesis-mcp.git"
  },
  "homepage": "https://github.com/maikershq/metaplex-genesis-mcp#readme",
  "bugs": {
    "url": "https://github.com/maikershq/metaplex-genesis-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "metaplex",
    "genesis",
    "solana",
    "blockchain",
    "ai",
    "llm"
  ],
  "bin": {
    "metaplex-genesis-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/*.js",
    "prepare": "pnpm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "./scripts/smoke-test.sh"
  },
  "dependencies": {
    "@metaplex-foundation/genesis": "^0.14.0",
    "@metaplex-foundation/mpl-toolbox": "^0.10.0",
    "@metaplex-foundation/umi": "^1.4.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
