{
  "name": "metaplex-genesis-mcp",
  "version": "1.0.0",
  "description": "MCP server for interacting with Metaplex Genesis program on Solana",
  "license": "MIT",
  "type": "module",
  "bin": {
    "metaplex-genesis-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/*.js",
    "prepare": "pnpm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "./scripts/smoke-test.sh"
  },
  "dependencies": {
    "@metaplex-foundation/genesis": "^0.14.0",
    "@metaplex-foundation/mpl-toolbox": "^0.10.0",
    "@metaplex-foundation/umi": "^1.4.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.4.1",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8"
  }
}
